rejection.value.integer = Стойността за „{name}“ не е число в разрешения диапазон.
rejection.value.token = Стойността за „{name}“ съдържа неразрешени знаци или е твърде дълга.
rejection.value.choice = Стойността за „{name}“ не е сред разрешените стойности.

console.usage = UrlBridge отваря зададени програми чрез собствени URL протоколи.\n\nИзползване:\n  UrlBridge.exe <връзка>           Проверява връзката, иска потвърждение и стартира програмата\n  UrlBridge.exe --test <връзка>    Показва какво би се стартирало, без да го стартира\n  UrlBridge.exe --validate         Проверява конфигурацията\n  UrlBridge.exe --version          Показва версията\n  UrlBridge.exe --help             Показва тази помощ
console.usage.unknown_option = Неизвестна опция: {option}
console.usage.missing_link = Необходима е връзка.
console.usage.too_many_arguments = Твърде много аргументи.
console.usage.invalid_characters = Командният ред съдържа невалидни знаци.
console.error = Грешка: {text}
console.warning = Предупреждение: {text}
console.rejected = Отхвърлено: {text}
console.language = Език: {name} ({code})
console.valid = Конфигурацията е валидна. Протоколи ({count}): {schemes}
console.no_protocols = няма
console.invalid = Конфигурацията е невалидна. Нищо няма да бъде стартирано.
console.test = Протокол:       {name} ({scheme})\nПрограма:       {program}\nАргументи:      {arguments}\nКоманден ред:{command_line}
console.nothing_started = Нищо не беше стартирано.
console.launch_failed = Програмата не можа да бъде стартирана. {text}
