# UrlBridge language file: Romanian (ro)
# Category: standard
# Generated by Claude (AI), not reviewed by a native speaker yet.
# Please report mistakes or better wording as an issue: https://github.com/TripleT3005/UrlBridge/issues
# Reviewed by: -
#
# Format: key = text. Keep the keys and placeholders such as {name} unchanged; \n starts a new line.
# Missing texts are taken from the fallback language, otherwise from English.

language.name = Română

confirm.title = Porniți {name}?
confirm.text = Un link vrea să pornească acest program. Continuați numai dacă ați deschis chiar dumneavoastră linkul.
confirm.program = Program:
confirm.arguments = Argumente:
confirm.no_arguments = (niciunul)
confirm.start = Pornire
confirm.cancel = Anulare

message.close = Închidere
message.configuration.title = UrlBridge nu este configurat corect
message.configuration.text = Nu a fost pornit nimic. Cereți administratorului să execute „UrlBridge.exe --validate”.
message.rejected.title = Linkul a fost respins
message.rejected.text = Nu a fost pornit nimic.
message.launch.title = Programul nu a putut fi pornit
message.launch.not_found = {path} nu a fost găsit sau nu este accesibil.
message.launch.windows_error = Eroare Windows {code}.

rejection.too_long = Linkul are mai mult de 2048 de caractere.
rejection.invalid_character = Linkul conține spații, caractere de control sau caractere din afara ASCII.
rejection.missing_scheme = Linkul nu are un nume de protocol valid.
rejection.missing_slashes = Linkul trebuie să aibă forma protocol://valoare.
rejection.query = Linkul conține o interogare (?).
rejection.fragment = Linkul conține un fragment (#).
rejection.user_info = Linkul conține informații despre utilizator (@).
rejection.empty_value = Linkul conține o valoare goală.
rejection.invalid_encoding = Linkul conține o codificare procentuală nevalidă.
rejection.unknown_protocol = Protocolul „{scheme}” nu este configurat.
rejection.value_count = Linkul conține {actual} valoare/valori, dar protocolul așteaptă {expected}.
rejection.value.unsafe = Valoarea pentru „{name}” conține caractere care nu sunt permise niciodată.
rejection.value.hostname = Valoarea pentru „{name}” nu este un nume de gazdă valid.
rejection.value.ipv4 = Valoarea pentru „{name}” nu este o adresă IPv4 validă.
rejection.value.host = Valoarea pentru „{name}” nu este nici un nume de gazdă valid, nici o adresă IPv4 validă.
rejection.value.integer = Valoarea pentru „{name}” nu este un număr din intervalul permis.
rejection.value.token = Valoarea pentru „{name}” conține caractere nepermise sau este prea lungă.
rejection.value.choice = Valoarea pentru „{name}” nu este una dintre valorile permise.

console.usage = UrlBridge deschide programe configurate prin protocoale URL proprii.\n\nUtilizare:\n  UrlBridge.exe <link>           Verifică linkul, cere confirmarea și pornește programul\n  UrlBridge.exe --test <link>    Arată ce ar fi pornit, fără a-l porni\n  UrlBridge.exe --validate       Verifică configurația\n  UrlBridge.exe --version        Afișează versiunea\n  UrlBridge.exe --help           Afișează acest ajutor
console.usage.unknown_option = Opțiune necunoscută: {option}
console.usage.missing_link = Este necesar un link.
console.usage.too_many_arguments = Prea multe argumente.
console.usage.invalid_characters = Linia de comandă conține caractere nevalide.
console.error = Eroare: {text}
console.warning = Avertisment: {text}
console.rejected = Respins: {text}
console.language = Limbă: {name} ({code})
console.valid = Configurația este validă. Protocoale ({count}): {schemes}
console.no_protocols = niciunul
console.invalid = Configurația nu este validă. Nu va fi pornit nimic.
console.test = Protocol:          {name} ({scheme})\nProgram:           {program}\nArgumente:         {arguments}\nLinie de comandă:  {command_line}
console.nothing_started = Nu a fost pornit nimic.
console.launch_failed = Programul nu a putut fi pornit. {text}
