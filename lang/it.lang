console.usage = UrlBridge apre programmi configurati tramite protocolli URL personalizzati.\n\nUtilizzo:\n  UrlBridge.exe <collegamento>           Controlla il collegamento, chiede conferma e avvia il programma\n  UrlBridge.exe --test <collegamento>    Mostra cosa verrebbe avviato senza avviarlo\n  UrlBridge.exe --validate               Controlla la configurazione\n  UrlBridge.exe --version                Mostra la versione\n  UrlBridge.exe --help                   Mostra questa guida
console.usage.unknown_option = Opzione sconosciuta: {option}
console.usage.missing_link = È necessario un collegamento.
console.usage.too_many_arguments = Troppi argomenti.
console.usage.invalid_characters = La riga di comando contiene caratteri non validi.
