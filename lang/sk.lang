console.usage = UrlBridge otvára nastavené programy pomocou vlastných protokolov URL.\n\nPoužitie:\n  UrlBridge.exe <odkaz>           Skontroluje odkaz, vyžiada potvrdenie a spustí program\n  UrlBridge.exe --test <odkaz>    Zobrazí, čo by sa spustilo, bez spustenia\n  UrlBridge.exe --validate        Skontroluje konfiguráciu\n  UrlBridge.exe --version         Zobrazí verziu\n  UrlBridge.exe --help            Zobrazí tohto pomocníka
console.usage.unknown_option = Neznáma voľba: {option}
console.usage.missing_link = Vyžaduje sa odkaz.
console.usage.too_many_arguments = Príliš veľa argumentov.
console.usage.invalid_characters = Príkazový riadok obsahuje neplatné znaky.
