# UrlBridge language file: Chinese (Traditional) (zh-Hant)
# Category: standard
# Generated by Claude (AI), not reviewed by a native speaker yet.
# Please report mistakes or better wording as an issue: https://github.com/TripleT3005/UrlBridge/issues
# Reviewed by: -
#
# Format: key = text. Keep the keys and placeholders such as {name} unchanged; \n starts a new line.
# Missing texts are taken from the fallback language, otherwise from English.

language.name = 繁體中文

confirm.title = 要啟動 {name} 嗎?
confirm.text = 某個連結想要啟動此程式。只有在連結是您自己開啟時才繼續。
confirm.program = 程式:
confirm.arguments = 引數:
confirm.no_arguments = (無)
confirm.start = 啟動
confirm.cancel = 取消

message.close = 關閉
message.configuration.title = UrlBridge 未正確設定
message.configuration.text = 未啟動任何項目。請要求系統管理員執行「UrlBridge.exe --validate」。
message.rejected.title = 連結已被拒絕
message.rejected.text = 未啟動任何項目。
message.launch.title = 無法啟動程式
message.launch.not_found = 找不到 {path} 或無法存取。
message.launch.windows_error = Windows 錯誤 {code}。

rejection.too_long = 連結長度超過 2048 個字元。
rejection.invalid_character = 連結包含空格、控制字元或 ASCII 以外的字元。
rejection.missing_scheme = 連結沒有有效的通訊協定名稱。
rejection.missing_slashes = 連結必須採用 protocol://value 的格式。
rejection.query = 連結包含查詢 (?)。
rejection.fragment = 連結包含片段 (#)。
rejection.user_info = 連結包含使用者資訊 (@)。
rejection.empty_value = 連結包含空值。
rejection.invalid_encoding = 連結包含無效的百分比編碼。
rejection.unknown_protocol = 通訊協定「{scheme}」未設定。
rejection.value_count = 連結包含 {actual} 個值,但通訊協定需要 {expected} 個。
rejection.value.unsafe = 「{name}」的值包含一律不允許的字元。
rejection.value.hostname = 「{name}」的值不是有效的主機名稱。
rejection.value.ipv4 = 「{name}」的值不是有效的 IPv4 位址。
rejection.value.host = 「{name}」的值既不是有效的主機名稱,也不是有效的 IPv4 位址。
rejection.value.integer = 「{name}」的值不是允許範圍內的數字。
rejection.value.token = 「{name}」的值包含不允許的字元或過長。
rejection.value.choice = 「{name}」的值不是允許的值之一。

console.usage = UrlBridge 透過自訂 URL 通訊協定開啟已設定的程式。\n\n用法:\n  UrlBridge.exe <連結>           檢查連結、要求確認並啟動程式\n  UrlBridge.exe --test <連結>    顯示將會啟動的內容,但不啟動\n  UrlBridge.exe --validate       檢查設定\n  UrlBridge.exe --version        顯示版本\n  UrlBridge.exe --help           顯示此說明
console.usage.unknown_option = 未知的選項:{option}
console.usage.missing_link = 必須提供連結。
console.usage.too_many_arguments = 引數過多。
console.usage.invalid_characters = 命令列包含無效字元。
console.error = 錯誤:{text}
console.warning = 警告:{text}
console.rejected = 已拒絕:{text}
console.language = 語言:{name} ({code})
console.valid = 設定有效。通訊協定 ({count}):{schemes}
console.no_protocols = 無
console.invalid = 設定無效。不會啟動任何項目。
console.test = 通訊協定:  {name} ({scheme})\n程式:      {program}\n引數:      {arguments}\n命令列:    {command_line}
console.nothing_started = 未啟動任何項目。
console.launch_failed = 無法啟動程式。{text}
