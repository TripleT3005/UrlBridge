# UrlBridge language file: Swedish (sv)
# Category: standard
# Generated by Claude (AI), not reviewed by a native speaker yet.
# Please report mistakes or better wording as an issue: https://github.com/TripleT3005/UrlBridge/issues
# Reviewed by: -
#
# Format: key = text. Keep the keys and placeholders such as {name} unchanged; \n starts a new line.
# Missing texts are taken from the fallback language, otherwise from English.

language.name = Svenska

confirm.title = Vill du starta {name}?
confirm.text = En länk vill starta det här programmet. Fortsätt bara om du själv har öppnat länken.
confirm.program = Program:
confirm.arguments = Argument:
confirm.no_arguments = (inga)
confirm.start = Starta
confirm.cancel = Avbryt

message.close = Stäng
message.configuration.title = UrlBridge är inte korrekt konfigurerat
message.configuration.text = Ingenting startades. Be din administratör att köra ”UrlBridge.exe --validate”.
message.rejected.title = Länken avvisades
message.rejected.text = Ingenting startades.
message.launch.title = Programmet kunde inte startas
message.launch.not_found = {path} hittades inte eller är inte tillgänglig.
message.launch.windows_error = Windows-fel {code}.

rejection.too_long = Länken är längre än 2048 tecken.
rejection.invalid_character = Länken innehåller mellanslag, kontrolltecken eller tecken utanför ASCII.
rejection.missing_scheme = Länken har inget giltigt protokollnamn.
rejection.missing_slashes = Länken måste ha formen protokoll://värde.
rejection.query = Länken innehåller en fråga (?).
rejection.fragment = Länken innehåller ett fragment (#).
rejection.user_info = Länken innehåller användaruppgifter (@).
rejection.empty_value = Länken innehåller ett tomt värde.
rejection.invalid_encoding = Länken innehåller ogiltig procentkodning.
rejection.unknown_protocol = Protokollet ”{scheme}” är inte konfigurerat.
rejection.value_count = Länken innehåller {actual} värde(n), men protokollet förväntar sig {expected}.
rejection.value.unsafe = Värdet för ”{name}” innehåller tecken som aldrig är tillåtna.
rejection.value.hostname = Värdet för ”{name}” är inte ett giltigt värdnamn.
rejection.value.ipv4 = Värdet för ”{name}” är inte en giltig IPv4-adress.
rejection.value.host = Värdet för ”{name}” är varken ett giltigt värdnamn eller en giltig IPv4-adress.
rejection.value.integer = Värdet för ”{name}” är inte ett tal inom det tillåtna intervallet.
rejection.value.token = Värdet för ”{name}” innehåller otillåtna tecken eller är för långt.
rejection.value.choice = Värdet för ”{name}” är inte ett av de tillåtna värdena.

console.usage = UrlBridge öppnar konfigurerade program via egna URL-protokoll.\n\nAnvändning:\n  UrlBridge.exe <länk>           Kontrollerar länken, ber om bekräftelse och startar programmet\n  UrlBridge.exe --test <länk>    Visar vad som skulle startas utan att starta det\n  UrlBridge.exe --validate       Kontrollerar konfigurationen\n  UrlBridge.exe --version        Visar versionen\n  UrlBridge.exe --help           Visar den här hjälpen
console.usage.unknown_option = Okänt alternativ: {option}
console.usage.missing_link = En länk krävs.
console.usage.too_many_arguments = För många argument.
console.usage.invalid_characters = Kommandoraden innehåller ogiltiga tecken.
console.error = Fel: {text}
console.warning = Varning: {text}
console.rejected = Avvisad: {text}
console.language = Språk: {name} ({code})
console.valid = Konfigurationen är giltig. Protokoll ({count}): {schemes}
console.no_protocols = inga
console.invalid = Konfigurationen är ogiltig. Ingenting kommer att startas.
console.test = Protokoll:    {name} ({scheme})\nProgram:      {program}\nArgument:     {arguments}\nKommandorad:  {command_line}
console.nothing_started = Ingenting startades.
console.launch_failed = Programmet kunde inte startas. {text}
