console.usage = UrlBridge atver iestatītas programmas, izmantojot pielāgotus URL protokolus.\n\nLietošana:\n  UrlBridge.exe <saite>           Pārbauda saiti, lūdz apstiprinājumu un palaiž programmu\n  UrlBridge.exe --test <saite>    Parāda, kas tiktu palaists, to nepalaižot\n  UrlBridge.exe --validate        Pārbauda konfigurāciju\n  UrlBridge.exe --version         Parāda versiju\n  UrlBridge.exe --help            Parāda šo palīdzību
console.usage.unknown_option = Nezināma opcija: {option}
console.usage.missing_link = Nepieciešama saite.
console.usage.too_many_arguments = Pārāk daudz argumentu.
console.usage.invalid_characters = Komandrindā ir nederīgas rakstzīmes.
