# UrlBridge language file: Finnish (fi)
# Category: standard
# Generated by Claude (AI), not reviewed by a native speaker yet.
# Please report mistakes or better wording as an issue: https://github.com/TripleT3005/UrlBridge/issues
# Reviewed by: -
#
# Format: key = text. Keep the keys and placeholders such as {name} unchanged; \n starts a new line.
# Missing texts are taken from the fallback language, otherwise from English.

language.name = Suomi

confirm.title = Käynnistetäänkö {name}?
confirm.text = Linkki haluaa käynnistää tämän ohjelman. Jatka vain, jos avasit linkin itse.
confirm.program = Ohjelma:
confirm.arguments = Argumentit:
confirm.no_arguments = (ei mitään)
confirm.start = Käynnistä
confirm.cancel = Peruuta

message.close = Sulje
message.configuration.title = UrlBridgea ei ole määritetty oikein
message.configuration.text = Mitään ei käynnistetty. Pyydä järjestelmänvalvojaa suorittamaan ”UrlBridge.exe --validate”.
message.rejected.title = Linkki hylättiin
message.rejected.text = Mitään ei käynnistetty.
message.launch.title = Ohjelmaa ei voitu käynnistää
message.launch.not_found = Kohdetta {path} ei löytynyt tai siihen ei ole pääsyä.
message.launch.windows_error = Windows-virhe {code}.

rejection.too_long = Linkki on pidempi kuin 2048 merkkiä.
rejection.invalid_character = Linkki sisältää välilyöntejä, ohjausmerkkejä tai ASCII-merkistön ulkopuolisia merkkejä.
rejection.missing_scheme = Linkillä ei ole kelvollista protokollan nimeä.
rejection.missing_slashes = Linkin on oltava muotoa protokolla://arvo.
rejection.query = Linkki sisältää kyselyn (?).
rejection.fragment = Linkki sisältää fragmentin (#).
rejection.user_info = Linkki sisältää käyttäjätietoja (@).
rejection.empty_value = Linkki sisältää tyhjän arvon.
rejection.invalid_encoding = Linkki sisältää virheellistä prosenttikoodausta.
rejection.unknown_protocol = Protokollaa ”{scheme}” ei ole määritetty.
rejection.value_count = Linkissä on {actual} arvo(a), mutta protokolla odottaa {expected}.
rejection.value.unsafe = Kohteen ”{name}” arvo sisältää merkkejä, jotka eivät ole koskaan sallittuja.
rejection.value.hostname = Kohteen ”{name}” arvo ei ole kelvollinen isäntänimi.
rejection.value.ipv4 = Kohteen ”{name}” arvo ei ole kelvollinen IPv4-osoite.
rejection.value.host = Kohteen ”{name}” arvo ei ole kelvollinen isäntänimi eikä kelvollinen IPv4-osoite.
rejection.value.integer = Kohteen ”{name}” arvo ei ole sallitun alueen luku.
rejection.value.token = Kohteen ”{name}” arvo sisältää kiellettyjä merkkejä tai on liian pitkä.
rejection.value.choice = Kohteen ”{name}” arvo ei ole mikään sallituista arvoista.

console.usage = UrlBridge avaa määritettyjä ohjelmia omien URL-protokollien kautta.\n\nKäyttö:\n  UrlBridge.exe <linkki>           Tarkistaa linkin, pyytää vahvistuksen ja käynnistää ohjelman\n  UrlBridge.exe --test <linkki>    Näyttää, mitä käynnistettäisiin, käynnistämättä sitä\n  UrlBridge.exe --validate         Tarkistaa määritykset\n  UrlBridge.exe --version          Näyttää version\n  UrlBridge.exe --help             Näyttää tämän ohjeen
console.usage.unknown_option = Tuntematon valinta: {option}
console.usage.missing_link = Linkki vaaditaan.
console.usage.too_many_arguments = Liian monta argumenttia.
console.usage.invalid_characters = Komentorivi sisältää virheellisiä merkkejä.
console.error = Virhe: {text}
console.warning = Varoitus: {text}
console.rejected = Hylätty: {text}
console.language = Kieli: {name} ({code})
console.valid = Määritykset ovat kelvolliset. Protokollat ({count}): {schemes}
console.no_protocols = ei mitään
console.invalid = Määritykset ovat virheelliset. Mitään ei käynnistetä.
console.test = Protokolla:  {name} ({scheme})\nOhjelma:     {program}\nArgumentit:  {arguments}\nKomentorivi: {command_line}
console.nothing_started = Mitään ei käynnistetty.
console.launch_failed = Ohjelmaa ei voitu käynnistää. {text}
