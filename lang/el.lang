rejection.query = Ο σύνδεσμος περιέχει ερώτημα (?).
rejection.fragment = Ο σύνδεσμος περιέχει τμήμα (#).
rejection.user_info = Ο σύνδεσμος περιέχει στοιχεία χρήστη (@).
rejection.empty_value = Ο σύνδεσμος περιέχει κενή τιμή.
rejection.invalid_encoding = Ο σύνδεσμος περιέχει μη έγκυρη κωδικοποίηση ποσοστού.
rejection.unknown_protocol = Το πρωτόκολλο «{scheme}» δεν έχει ρυθμιστεί.
rejection.value_count = Ο σύνδεσμος περιέχει {actual} τιμή(ές), αλλά το πρωτόκολλο αναμένει {expected}.
rejection.value.unsafe = Η τιμή για «{name}» περιέχει χαρακτήρες που δεν επιτρέπονται ποτέ.
rejection.value.hostname = Η τιμή για «{name}» δεν είναι έγκυρο όνομα κεντρικού υπολογιστή.
rejection.value.ipv4 = Η τιμή για «{name}» δεν είναι έγκυρη διεύθυνση IPv4.
rejection.value.host = Η τιμή για «{name}» δεν είναι ούτε έγκυρο όνομα κεντρικού υπολογιστή ούτε έγκυρη διεύθυνση IPv4.
rejection.value.integer = Η τιμή για «{name}» δεν είναι αριθμός εντός του επιτρεπόμενου εύρους.
rejection.value.token = Η τιμή για «{name}» περιέχει μη επιτρεπόμενους χαρακτήρες ή είναι πολύ μεγάλη.
rejection.value.choice = Η τιμή για «{name}» δεν είναι μία από τις επιτρεπόμενες τιμές.

console.usage = Το UrlBridge ανοίγει ρυθμισμένα προγράμματα μέσω προσαρμοσμένων πρωτοκόλλων URL.\n\nΧρήση:\n  UrlBridge.exe <σύνδεσμος>           Ελέγχει τον σύνδεσμο, ζητά επιβεβαίωση και εκκινεί το πρόγραμμα\n  UrlBridge.exe --test <σύνδεσμος>    Δείχνει τι θα εκκινούνταν χωρίς να το εκκινήσει\n  UrlBridge.exe --validate            Ελέγχει τη διαμόρφωση\n  UrlBridge.exe --version             Δείχνει την έκδοση\n  UrlBridge.exe --help                Δείχνει αυτή τη βοήθεια
console.usage.unknown_option = Άγνωστη επιλογή: {option}
console.usage.missing_link = Απαιτείται σύνδεσμος.
console.usage.too_many_arguments = Πάρα πολλά ορίσματα.
console.usage.invalid_characters = Η γραμμή εντολών περιέχει μη έγκυρους χαρακτήρες.
console.error = Σφάλμα: {text}
console.warning = Προειδοποίηση: {text}
console.rejected = Απορρίφθηκε: {text}
console.language = Γλώσσα: {name} ({code})
console.valid = Η διαμόρφωση είναι έγκυρη. Πρωτόκολλα ({count}): {schemes}
console.no_protocols = κανένα
console.invalid = Η διαμόρφωση δεν είναι έγκυρη. Δεν θα εκκινηθεί τίποτα.
