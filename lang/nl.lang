#
# Format: key = text. Keep the keys and placeholders such as {name} unchanged; \n starts a new line.
# Missing texts are taken from the fallback language, otherwise from English.

language.name = Nederlands

confirm.title = {name} starten?
confirm.text = Een koppeling wil dit programma starten. Ga alleen verder als je de koppeling zelf hebt geopend.
confirm.program = Programma:
confirm.arguments = Argumenten:
confirm.no_arguments = (geen)
confirm.start = Starten
confirm.cancel = Annuleren

message.close = Sluiten
