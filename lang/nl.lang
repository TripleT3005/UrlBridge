rejection.unknown_protocol = Het protocol "{scheme}" is niet ingesteld.
rejection.value_count = De koppeling bevat {actual} waarde(n), maar het protocol verwacht er {expected}.
rejection.value.unsafe = De waarde voor "{name}" bevat tekens die nooit zijn toegestaan.
