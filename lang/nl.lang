console.usage = UrlBridge opent ingestelde programma's via eigen URL-protocollen.\n\nGebruik:\n  UrlBridge.exe <koppeling>           Controleert de koppeling, vraagt om bevestiging en start het programma\n  UrlBridge.exe --test <koppeling>    Toont wat er zou worden gestart, zonder het te starten\n  UrlBridge.exe --validate            Controleert de configuratie\n  UrlBridge.exe --version             Toont de versie\n  UrlBridge.exe --help                Toont deze help
console.usage.unknown_option = Onbekende optie: {option}
console.usage.missing_link = Er is een koppeling nodig.
console.usage.too_many_arguments = Te veel argumenten.
console.usage.invalid_characters = De opdrachtregel bevat ongeldige tekens.
console.error = Fout: {text}
console.warning = Waarschuwing: {text}
console.rejected = Geweigerd: {text}
console.language = Taal: {name} ({code})
console.valid = De configuratie is geldig. Protocollen ({count}): {schemes}
console.no_protocols = geen
console.invalid = De configuratie is ongeldig. Er wordt niets gestart.
console.test = Protocol:        {name} ({scheme})\nProgramma:       {program}\nArgumenten:      {arguments}\nOpdrachtregel:   {command_line}
console.nothing_started = Er is niets gestart.
