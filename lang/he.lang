message.rejected.title = הקישור נדחה
message.rejected.text = לא הופעל דבר.
message.launch.title = לא ניתן היה להפעיל את התוכנית
message.launch.not_found = {path} לא נמצא או שאין אליו גישה.
message.launch.windows_error = שגיאת Windows {code}.

rejection.too_long = הקישור ארוך מ-2048 תווים.
