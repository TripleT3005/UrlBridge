rejection.value.integer = הערך עבור "{name}" אינו מספר בטווח המותר.
rejection.value.token = הערך עבור "{name}" מכיל תווים לא מותרים או ארוך מדי.
rejection.value.choice = הערך עבור "{name}" אינו אחד מהערכים המותרים.

console.usage = UrlBridge פותח תוכניות מוגדרות דרך פרוטוקולי URL מותאמים אישית.\n\nשימוש:\n  UrlBridge.exe <link>           בודק את הקישור, מבקש אישור ומפעיל את התוכנית\n  UrlBridge.exe --test <link>    מציג מה יופעל מבלי להפעיל אותו\n  UrlBridge.exe --validate       בודק את התצורה\n  UrlBridge.exe --version        מציג את הגרסה\n  UrlBridge.exe --help           מציג עזרה זו
console.usage.unknown_option = אפשרות לא ידועה: {option}
console.usage.missing_link = נדרש קישור.
console.usage.too_many_arguments = יותר מדי ארגומנטים.
console.usage.invalid_characters = שורת הפקודה מכילה תווים לא חוקיים.
console.error = שגיאה: {text}
console.warning = אזהרה: {text}
console.rejected = נדחה: {text}
console.language = שפה: {name} ({code})
