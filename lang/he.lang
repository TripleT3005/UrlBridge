#
# Format: key = text. Keep the keys and placeholders such as {name} unchanged; \n starts a new line.
# Missing texts are taken from the fallback language, otherwise from English.

language.name = עברית
language.direction = rtl

confirm.title = להפעיל את {name}?
confirm.text = קישור מבקש להפעיל את התוכנית הזו. המשך רק אם פתחת את הקישור בעצמך.
confirm.program = תוכנית:
confirm.arguments = ארגומנטים:
