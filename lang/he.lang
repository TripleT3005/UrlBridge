rejection.query = הקישור מכיל שאילתה (?).
rejection.fragment = הקישור מכיל מקטע (#).
rejection.user_info = הקישור מכיל פרטי משתמש (@).
rejection.empty_value = הקישור מכיל ערך ריק.
rejection.invalid_encoding = הקישור מכיל קידוד אחוזים לא חוקי.
rejection.unknown_protocol = הפרוטוקול "{scheme}" אינו מוגדר.
rejection.value_count = הקישור מכיל {actual} ערכים, אך הפרוטוקול מצפה ל-{expected}.
rejection.value.unsafe = הערך עבור "{name}" מכיל תווים שאף פעם אינם מותרים.
rejection.value.hostname = הערך עבור "{name}" אינו שם מארח חוקי.
rejection.value.ipv4 = הערך עבור "{name}" אינו כתובת IPv4 חוקית.
