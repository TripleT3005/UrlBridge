# UrlBridge language file: Indonesian (id)
# Category: standard
# Generated by Claude (AI), not reviewed by a native speaker yet.
# Please report mistakes or better wording as an issue: https://github.com/TripleT3005/UrlBridge/issues
# Reviewed by: -
#
# Format: key = text. Keep the keys and placeholders such as {name} unchanged; \n starts a new line.
# Missing texts are taken from the fallback language, otherwise from English.

language.name = Bahasa Indonesia

confirm.title = Jalankan {name}?
confirm.text = Sebuah tautan ingin menjalankan program ini. Lanjutkan hanya jika Anda sendiri yang membuka tautan tersebut.
confirm.program = Program:
confirm.arguments = Argumen:
confirm.no_arguments = (tidak ada)
confirm.start = Jalankan
confirm.cancel = Batal

message.close = Tutup
message.configuration.title = UrlBridge tidak diatur dengan benar
message.configuration.text = Tidak ada yang dijalankan. Minta administrator Anda untuk menjalankan "UrlBridge.exe --validate".
message.rejected.title = Tautan ditolak
message.rejected.text = Tidak ada yang dijalankan.
message.launch.title = Program tidak dapat dijalankan
message.launch.not_found = {path} tidak ditemukan atau tidak dapat diakses.
message.launch.windows_error = Kesalahan Windows {code}.

rejection.too_long = Tautan lebih panjang dari 2048 karakter.
rejection.invalid_character = Tautan berisi spasi, karakter kontrol, atau karakter di luar ASCII.
rejection.missing_scheme = Tautan tidak memiliki nama protokol yang valid.
rejection.missing_slashes = Tautan harus berbentuk protokol://nilai.
rejection.query = Tautan berisi kueri (?).
rejection.fragment = Tautan berisi fragmen (#).
rejection.user_info = Tautan berisi informasi pengguna (@).
rejection.empty_value = Tautan berisi nilai kosong.
rejection.invalid_encoding = Tautan berisi pengodean persen yang tidak valid.
rejection.unknown_protocol = Protokol "{scheme}" tidak diatur.
rejection.value_count = Tautan berisi {actual} nilai, tetapi protokol mengharapkan {expected}.
rejection.value.unsafe = Nilai untuk "{name}" berisi karakter yang tidak pernah diizinkan.
rejection.value.hostname = Nilai untuk "{name}" bukan nama host yang valid.
rejection.value.ipv4 = Nilai untuk "{name}" bukan alamat IPv4 yang valid.
rejection.value.host = Nilai untuk "{name}" bukan nama host yang valid maupun alamat IPv4 yang valid.
rejection.value.integer = Nilai untuk "{name}" bukan angka dalam rentang yang diizinkan.
rejection.value.token = Nilai untuk "{name}" berisi karakter yang tidak diizinkan atau terlalu panjang.
rejection.value.choice = Nilai untuk "{name}" bukan salah satu nilai yang diizinkan.

console.usage = UrlBridge membuka program yang telah diatur melalui protokol URL khusus.\n\nPenggunaan:\n  UrlBridge.exe <tautan>           Memeriksa tautan, meminta konfirmasi, dan menjalankan program\n  UrlBridge.exe --test <tautan>    Menampilkan apa yang akan dijalankan tanpa menjalankannya\n  UrlBridge.exe --validate         Memeriksa konfigurasi\n  UrlBridge.exe --version          Menampilkan versi\n  UrlBridge.exe --help             Menampilkan bantuan ini
console.usage.unknown_option = Opsi tidak dikenal: {option}
console.usage.missing_link = Tautan diperlukan.
console.usage.too_many_arguments = Terlalu banyak argumen.
console.usage.invalid_characters = Baris perintah berisi karakter yang tidak valid.
console.error = Kesalahan: {text}
console.warning = Peringatan: {text}
console.rejected = Ditolak: {text}
console.language = Bahasa: {name} ({code})
console.valid = Konfigurasi valid. Protokol ({count}): {schemes}
console.no_protocols = tidak ada
console.invalid = Konfigurasi tidak valid. Tidak ada yang akan dijalankan.
console.test = Protokol:        {name} ({scheme})\nProgram:         {program}\nArgumen:         {arguments}\nBaris perintah:  {command_line}
console.nothing_started = Tidak ada yang dijalankan.
console.launch_failed = Program tidak dapat dijalankan. {text}
