# UrlBridge language file: Korean (ko)
# Category: standard
# Generated by Claude (AI), not reviewed by a native speaker yet.
# Please report mistakes or better wording as an issue: https://github.com/TripleT3005/UrlBridge/issues
# Reviewed by: -
#
# Format: key = text. Keep the keys and placeholders such as {name} unchanged; \n starts a new line.
# Missing texts are taken from the fallback language, otherwise from English.

language.name = 한국어

confirm.title = {name}을(를) 시작할까요?
confirm.text = 링크가 이 프로그램을 시작하려고 합니다. 직접 링크를 연 경우에만 계속하세요.
confirm.program = 프로그램:
confirm.arguments = 인수:
confirm.no_arguments = (없음)
confirm.start = 시작
confirm.cancel = 취소

message.close = 닫기
message.configuration.title = UrlBridge가 올바르게 설정되지 않았습니다
message.configuration.text = 아무것도 시작되지 않았습니다. 관리자에게 "UrlBridge.exe --validate"를 실행해 달라고 요청하세요.
message.rejected.title = 링크가 거부되었습니다
message.rejected.text = 아무것도 시작되지 않았습니다.
message.launch.title = 프로그램을 시작할 수 없습니다
message.launch.not_found = {path}을(를) 찾을 수 없거나 액세스할 수 없습니다.
message.launch.windows_error = Windows 오류 {code}.

rejection.too_long = 링크가 2048자보다 깁니다.
rejection.invalid_character = 링크에 공백, 제어 문자 또는 ASCII 이외의 문자가 포함되어 있습니다.
rejection.missing_scheme = 링크에 유효한 프로토콜 이름이 없습니다.
rejection.missing_slashes = 링크는 protocol://value 형식이어야 합니다.
rejection.query = 링크에 쿼리(?)가 포함되어 있습니다.
rejection.fragment = 링크에 조각(#)이 포함되어 있습니다.
rejection.user_info = 링크에 사용자 정보(@)가 포함되어 있습니다.
rejection.empty_value = 링크에 빈 값이 포함되어 있습니다.
rejection.invalid_encoding = 링크에 잘못된 퍼센트 인코딩이 포함되어 있습니다.
rejection.unknown_protocol = 프로토콜 "{scheme}"이(가) 설정되어 있지 않습니다.
rejection.value_count = 링크에 값이 {actual}개 있지만 프로토콜은 {expected}개를 요구합니다.
rejection.value.unsafe = "{name}"의 값에 절대 허용되지 않는 문자가 포함되어 있습니다.
rejection.value.hostname = "{name}"의 값이 유효한 호스트 이름이 아닙니다.
rejection.value.ipv4 = "{name}"의 값이 유효한 IPv4 주소가 아닙니다.
rejection.value.host = "{name}"의 값이 유효한 호스트 이름도, 유효한 IPv4 주소도 아닙니다.
rejection.value.integer = "{name}"의 값이 허용된 범위의 숫자가 아닙니다.
rejection.value.token = "{name}"의 값에 허용되지 않는 문자가 있거나 너무 깁니다.
rejection.value.choice = "{name}"의 값이 허용된 값 중 하나가 아닙니다.

console.usage = UrlBridge는 사용자 지정 URL 프로토콜을 통해 설정된 프로그램을 엽니다.\n\n사용법:\n  UrlBridge.exe <링크>           링크를 확인하고 확인을 요청한 후 프로그램을 시작합니다\n  UrlBridge.exe --test <링크>    시작하지 않고 무엇이 시작될지 표시합니다\n  UrlBridge.exe --validate       구성을 확인합니다\n  UrlBridge.exe --version        버전을 표시합니다\n  UrlBridge.exe --help           이 도움말을 표시합니다
console.usage.unknown_option = 알 수 없는 옵션: {option}
console.usage.missing_link = 링크가 필요합니다.
console.usage.too_many_arguments = 인수가 너무 많습니다.
console.usage.invalid_characters = 명령줄에 잘못된 문자가 포함되어 있습니다.
console.error = 오류: {text}
console.warning = 경고: {text}
console.rejected = 거부됨: {text}
console.language = 언어: {name} ({code})
console.valid = 구성이 유효합니다. 프로토콜({count}): {schemes}
console.no_protocols = 없음
console.invalid = 구성이 잘못되었습니다. 아무것도 시작되지 않습니다.
console.test = 프로토콜:  {name} ({scheme})\n프로그램:  {program}\n인수:      {arguments}\n명령줄:    {command_line}
console.nothing_started = 아무것도 시작되지 않았습니다.
console.launch_failed = 프로그램을 시작할 수 없습니다. {text}
