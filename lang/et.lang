console.usage = UrlBridge avab seadistatud programme kohandatud URL-protokollide kaudu.\n\nKasutamine:\n  UrlBridge.exe <link>           Kontrollib linki, küsib kinnitust ja käivitab programmi\n  UrlBridge.exe --test <link>    Näitab, mis käivitataks, ilma seda käivitamata\n  UrlBridge.exe --validate       Kontrollib konfiguratsiooni\n  UrlBridge.exe --version        Näitab versiooni\n  UrlBridge.exe --help           Näitab seda abi
console.usage.unknown_option = Tundmatu suvand: {option}
console.usage.missing_link = Link on nõutav.
console.usage.too_many_arguments = Liiga palju argumente.
console.usage.invalid_characters = Käsureal on kehtetuid märke.
