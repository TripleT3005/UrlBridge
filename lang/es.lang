# UrlBridge language file: Spanish (es)
# Category: standard
# Generated by Claude (AI), not reviewed by a native speaker yet.
# Please report mistakes or better wording as an issue: https://github.com/TripleT3005/UrlBridge/issues
# Reviewed by: -
#
# Format: key = text. Keep the keys and placeholders such as {name} unchanged; \n starts a new line.
# Missing texts are taken from the fallback language, otherwise from English.

language.name = Español

confirm.title = ¿Iniciar {name}?
confirm.text = Un vínculo quiere iniciar este programa. Continúa solo si abriste el vínculo tú mismo.
confirm.program = Programa:
confirm.arguments = Argumentos:
confirm.no_arguments = (ninguno)
confirm.start = Iniciar
confirm.cancel = Cancelar

message.close = Cerrar
message.configuration.title = UrlBridge no está configurado correctamente
message.configuration.text = No se inició nada. Pide a tu administrador que ejecute «UrlBridge.exe --validate».
message.rejected.title = Se rechazó el vínculo
message.rejected.text = No se inició nada.
message.launch.title = No se pudo iniciar el programa
message.launch.not_found = No se encontró {path} o no se puede acceder a él.
message.launch.windows_error = Error de Windows {code}.

rejection.too_long = El vínculo tiene más de 2048 caracteres.
rejection.invalid_character = El vínculo contiene espacios, caracteres de control o caracteres fuera de ASCII.
rejection.missing_scheme = El vínculo no tiene un nombre de protocolo válido.
rejection.missing_slashes = El vínculo debe tener la forma protocolo://valor.
rejection.query = El vínculo contiene una consulta (?).
rejection.fragment = El vínculo contiene un fragmento (#).
rejection.user_info = El vínculo contiene información de usuario (@).
rejection.empty_value = El vínculo contiene un valor vacío.
rejection.invalid_encoding = El vínculo contiene una codificación porcentual no válida.
rejection.unknown_protocol = El protocolo «{scheme}» no está configurado.
rejection.value_count = El vínculo contiene {actual} valor(es), pero el protocolo espera {expected}.
rejection.value.unsafe = El valor de «{name}» contiene caracteres que nunca están permitidos.
rejection.value.hostname = El valor de «{name}» no es un nombre de host válido.
rejection.value.ipv4 = El valor de «{name}» no es una dirección IPv4 válida.
rejection.value.host = El valor de «{name}» no es ni un nombre de host válido ni una dirección IPv4 válida.
rejection.value.integer = El valor de «{name}» no es un número dentro del intervalo permitido.
rejection.value.token = El valor de «{name}» contiene caracteres no permitidos o es demasiado largo.
rejection.value.choice = El valor de «{name}» no es uno de los valores permitidos.

console.usage = UrlBridge abre programas configurados mediante protocolos URL propios.\n\nUso:\n  UrlBridge.exe <vínculo>           Comprueba el vínculo, pide confirmación e inicia el programa\n  UrlBridge.exe --test <vínculo>    Muestra lo que se iniciaría sin iniciarlo\n  UrlBridge.exe --validate          Comprueba la configuración\n  UrlBridge.exe --version           Muestra la versión\n  UrlBridge.exe --help              Muestra esta ayuda
console.usage.unknown_option = Opción desconocida: {option}
console.usage.missing_link = Se necesita un vínculo.
console.usage.too_many_arguments = Demasiados argumentos.
console.usage.invalid_characters = La línea de comandos contiene caracteres no válidos.
console.error = Error: {text}
console.warning = Advertencia: {text}
console.rejected = Rechazado: {text}
console.language = Idioma: {name} ({code})
console.valid = La configuración es válida. Protocolos ({count}): {schemes}
console.no_protocols = ninguno
console.invalid = La configuración no es válida. No se iniciará nada.
console.test = Protocolo:          {name} ({scheme})\nPrograma:           {program}\nArgumentos:         {arguments}\nLínea de comandos:  {command_line}
console.nothing_started = No se inició nada.
console.launch_failed = No se pudo iniciar el programa. {text}
