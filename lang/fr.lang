# UrlBridge language file: French (fr)
# Category: standard
# Generated by Claude (AI), not reviewed by a native speaker yet.
# Please report mistakes or better wording as an issue: https://github.com/TripleT3005/UrlBridge/issues
# Reviewed by: -
#
# Format: key = text. Keep the keys and placeholders such as {name} unchanged; \n starts a new line.
# Missing texts are taken from the fallback language, otherwise from English.

language.name = Français

confirm.title = Démarrer {name} ?
confirm.text = Un lien veut démarrer ce programme. Ne continuez que si vous avez ouvert ce lien vous-même.
confirm.program = Programme :
confirm.arguments = Arguments :
confirm.no_arguments = (aucun)
confirm.start = Démarrer
confirm.cancel = Annuler

message.close = Fermer
message.configuration.title = UrlBridge n’est pas configuré correctement
message.configuration.text = Rien n’a été démarré. Demandez à votre administrateur d’exécuter « UrlBridge.exe --validate ».
message.rejected.title = Le lien a été refusé
message.rejected.text = Rien n’a été démarré.
message.launch.title = Le programme n’a pas pu être démarré
message.launch.not_found = {path} est introuvable ou inaccessible.
message.launch.windows_error = Erreur Windows {code}.

rejection.too_long = Le lien dépasse 2048 caractères.
rejection.invalid_character = Le lien contient des espaces, des caractères de contrôle ou des caractères hors ASCII.
rejection.missing_scheme = Le lien n’a pas de nom de protocole valide.
rejection.missing_slashes = Le lien doit avoir la forme protocole://valeur.
rejection.query = Le lien contient une requête (?).
rejection.fragment = Le lien contient un fragment (#).
rejection.user_info = Le lien contient des informations d’utilisateur (@).
rejection.empty_value = Le lien contient une valeur vide.
rejection.invalid_encoding = Le lien contient un encodage-pourcent non valide.
rejection.unknown_protocol = Le protocole « {scheme} » n’est pas configuré.
rejection.value_count = Le lien contient {actual} valeur(s), mais le protocole en attend {expected}.
rejection.value.unsafe = La valeur de « {name} » contient des caractères qui ne sont jamais autorisés.
rejection.value.hostname = La valeur de « {name} » n’est pas un nom d’hôte valide.
rejection.value.ipv4 = La valeur de « {name} » n’est pas une adresse IPv4 valide.
rejection.value.host = La valeur de « {name} » n’est ni un nom d’hôte valide ni une adresse IPv4 valide.
rejection.value.integer = La valeur de « {name} » n’est pas un nombre dans la plage autorisée.
rejection.value.token = La valeur de « {name} » contient des caractères non autorisés ou est trop longue.
rejection.value.choice = La valeur de « {name} » ne fait pas partie des valeurs autorisées.

console.usage = UrlBridge ouvre des programmes configurés à partir de protocoles URL personnalisés.\n\nUtilisation :\n  UrlBridge.exe <lien>           Vérifie le lien, demande une confirmation et démarre le programme\n  UrlBridge.exe --test <lien>    Affiche ce qui serait démarré sans le démarrer\n  UrlBridge.exe --validate       Vérifie la configuration\n  UrlBridge.exe --version        Affiche la version\n  UrlBridge.exe --help           Affiche cette aide
console.usage.unknown_option = Option inconnue : {option}
console.usage.missing_link = Un lien est requis.
console.usage.too_many_arguments = Trop d’arguments.
console.usage.invalid_characters = La ligne de commande contient des caractères non valides.
console.error = Erreur : {text}
console.warning = Avertissement : {text}
console.rejected = Refusé : {text}
console.language = Langue : {name} ({code})
console.valid = La configuration est valide. Protocoles ({count}) : {schemes}
console.no_protocols = aucun
console.invalid = La configuration n’est pas valide. Rien ne sera démarré.
console.test = Protocole :          {name} ({scheme})\nProgramme :          {program}\nArguments :          {arguments}\nLigne de commande :  {command_line}
console.nothing_started = Rien n’a été démarré.
console.launch_failed = Le programme n’a pas pu être démarré. {text}
