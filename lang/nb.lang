# UrlBridge language file: Norwegian Bokmål (nb)
# Category: standard
# Generated by Claude (AI), not reviewed by a native speaker yet.
# Please report mistakes or better wording as an issue: https://github.com/TripleT3005/UrlBridge/issues
# Reviewed by: -
#
# Format: key = text. Keep the keys and placeholders such as {name} unchanged; \n starts a new line.
# Missing texts are taken from the fallback language, otherwise from English.

language.name = Norsk bokmål

confirm.title = Vil du starte {name}?
confirm.text = En lenke vil starte dette programmet. Fortsett bare hvis du selv åpnet lenken.
confirm.program = Program:
confirm.arguments = Argumenter:
confirm.no_arguments = (ingen)
confirm.start = Start
confirm.cancel = Avbryt

message.close = Lukk
message.configuration.title = UrlBridge er ikke riktig konfigurert
message.configuration.text = Ingenting ble startet. Be administratoren din om å kjøre «UrlBridge.exe --validate».
message.rejected.title = Lenken ble avvist
message.rejected.text = Ingenting ble startet.
message.launch.title = Programmet kunne ikke startes
message.launch.not_found = {path} ble ikke funnet eller er ikke tilgjengelig.
message.launch.windows_error = Windows-feil {code}.

rejection.too_long = Lenken er lengre enn 2048 tegn.
rejection.invalid_character = Lenken inneholder mellomrom, kontrolltegn eller tegn utenfor ASCII.
rejection.missing_scheme = Lenken har ikke et gyldig protokollnavn.
rejection.missing_slashes = Lenken må ha formen protokoll://verdi.
rejection.query = Lenken inneholder en spørring (?).
rejection.fragment = Lenken inneholder et fragment (#).
rejection.user_info = Lenken inneholder brukerinformasjon (@).
rejection.empty_value = Lenken inneholder en tom verdi.
rejection.invalid_encoding = Lenken inneholder ugyldig prosentkoding.
rejection.unknown_protocol = Protokollen «{scheme}» er ikke konfigurert.
rejection.value_count = Lenken inneholder {actual} verdi(er), men protokollen forventer {expected}.
rejection.value.unsafe = Verdien for «{name}» inneholder tegn som aldri er tillatt.
rejection.value.hostname = Verdien for «{name}» er ikke et gyldig vertsnavn.
rejection.value.ipv4 = Verdien for «{name}» er ikke en gyldig IPv4-adresse.
rejection.value.host = Verdien for «{name}» er verken et gyldig vertsnavn eller en gyldig IPv4-adresse.
rejection.value.integer = Verdien for «{name}» er ikke et tall innenfor det tillatte området.
rejection.value.token = Verdien for «{name}» inneholder tegn som ikke er tillatt, eller er for lang.
rejection.value.choice = Verdien for «{name}» er ikke en av de tillatte verdiene.

console.usage = UrlBridge åpner konfigurerte programmer via egne URL-protokoller.\n\nBruk:\n  UrlBridge.exe <lenke>           Kontrollerer lenken, ber om bekreftelse og starter programmet\n  UrlBridge.exe --test <lenke>    Viser hva som ville blitt startet, uten å starte det\n  UrlBridge.exe --validate        Kontrollerer konfigurasjonen\n  UrlBridge.exe --version         Viser versjonen\n  UrlBridge.exe --help            Viser denne hjelpen
console.usage.unknown_option = Ukjent alternativ: {option}
console.usage.missing_link = En lenke er påkrevd.
console.usage.too_many_arguments = For mange argumenter.
console.usage.invalid_characters = Kommandolinjen inneholder ugyldige tegn.
console.error = Feil: {text}
console.warning = Advarsel: {text}
console.rejected = Avvist: {text}
console.language = Språk: {name} ({code})
console.valid = Konfigurasjonen er gyldig. Protokoller ({count}): {schemes}
console.no_protocols = ingen
console.invalid = Konfigurasjonen er ugyldig. Ingenting blir startet.
console.test = Protokoll:     {name} ({scheme})\nProgram:       {program}\nArgumenter:    {arguments}\nKommandolinje: {command_line}
console.nothing_started = Ingenting ble startet.
console.launch_failed = Programmet kunne ikke startes. {text}
