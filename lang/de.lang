# UrlBridge language file: German (de)
# Category: standard
# Generated by Claude (AI) and reviewed.
# Please report mistakes or better wording as an issue: https://github.com/TripleT3005/UrlBridge/issues
# Reviewed by: @TripleT3005
#
# Format: key = text. Keep the keys and placeholders such as {name} unchanged; \n starts a new line.
# Missing texts are taken from the fallback language, otherwise from English.

language.name = Deutsch

confirm.title = {name} starten?
confirm.text = Ein Link möchte dieses Programm starten. Fahre nur fort, wenn du den Link selbst geöffnet hast.
confirm.program = Programm:
confirm.arguments = Argumente:
confirm.no_arguments = (keine)
confirm.start = Starten
confirm.cancel = Abbrechen

message.close = Schließen
message.configuration.title = UrlBridge ist nicht richtig eingerichtet
message.configuration.text = Es wurde nichts gestartet. Bitte deinen Administrator, „UrlBridge.exe --validate“ auszuführen.
message.rejected.title = Der Link wurde abgelehnt
message.rejected.text = Es wurde nichts gestartet.
message.launch.title = Das Programm konnte nicht gestartet werden
message.launch.not_found = {path} wurde nicht gefunden oder ist nicht erreichbar.
message.launch.windows_error = Windows-Fehler {code}.

rejection.too_long = Der Link ist länger als 2048 Zeichen.
rejection.invalid_character = Der Link enthält Leerzeichen, Steuerzeichen oder Zeichen außerhalb von ASCII.
rejection.missing_scheme = Der Link hat keinen gültigen Protokollnamen.
rejection.missing_slashes = Der Link muss die Form protokoll://wert haben.
rejection.query = Der Link enthält eine Abfrage (?).
rejection.fragment = Der Link enthält ein Fragment (#).
rejection.user_info = Der Link enthält Benutzerangaben (@).
rejection.empty_value = Der Link enthält einen leeren Wert.
rejection.invalid_encoding = Der Link enthält eine ungültige Prozent-Kodierung.
rejection.unknown_protocol = Das Protokoll „{scheme}“ ist nicht eingerichtet.
rejection.value_count = Der Link enthält {actual} Wert(e), das Protokoll erwartet aber {expected}.
rejection.value.unsafe = Der Wert für „{name}“ enthält Zeichen, die nie erlaubt sind.
rejection.value.hostname = Der Wert für „{name}“ ist kein gültiger Rechnername.
rejection.value.ipv4 = Der Wert für „{name}“ ist keine gültige IPv4-Adresse.
rejection.value.host = Der Wert für „{name}“ ist weder ein gültiger Rechnername noch eine gültige IPv4-Adresse.
rejection.value.integer = Der Wert für „{name}“ ist keine Zahl im erlaubten Bereich.
rejection.value.token = Der Wert für „{name}“ enthält nicht erlaubte Zeichen oder ist zu lang.
rejection.value.choice = Der Wert für „{name}“ ist keiner der erlaubten Werte.

console.usage = UrlBridge öffnet festgelegte Programme über eigene URL-Protokolle.\n\nAufruf:\n  UrlBridge.exe <Link>           Prüft den Link, fragt nach und startet das Programm\n  UrlBridge.exe --test <Link>    Zeigt, was gestartet würde, ohne es zu starten\n  UrlBridge.exe --validate       Prüft die Konfiguration\n  UrlBridge.exe --version        Zeigt die Version\n  UrlBridge.exe --help           Zeigt diese Hilfe
console.usage.unknown_option = Unbekannte Option: {option}
console.usage.missing_link = Es fehlt ein Link.
console.usage.too_many_arguments = Zu viele Argumente.
console.usage.invalid_characters = Die Kommandozeile enthält ungültige Zeichen.
console.error = Fehler: {text}
console.warning = Warnung: {text}
console.rejected = Abgelehnt: {text}
console.language = Sprache: {name} ({code})
console.valid = Die Konfiguration ist gültig. Protokolle ({count}): {schemes}
console.no_protocols = keine
console.invalid = Die Konfiguration ist ungültig. Es wird nichts gestartet.
console.test = Protokoll:     {name} ({scheme})\nProgramm:      {program}\nArgumente:     {arguments}\nKommandozeile: {command_line}
console.nothing_started = Es wurde nichts gestartet.
console.launch_failed = Das Programm konnte nicht gestartet werden. {text}
