rejection.value.choice = Wartość dla „{name}” nie jest żadną z dozwolonych wartości.

console.usage = UrlBridge otwiera skonfigurowane programy za pomocą własnych protokołów URL.\n\nUżycie:\n  UrlBridge.exe <link>           Sprawdza link, prosi o potwierdzenie i uruchamia program\n  UrlBridge.exe --test <link>    Pokazuje, co zostałoby uruchomione, bez uruchamiania\n  UrlBridge.exe --validate       Sprawdza konfigurację\n  UrlBridge.exe --version        Pokazuje wersję\n  UrlBridge.exe --help           Pokazuje tę pomoc
console.usage.unknown_option = Nieznana opcja: {option}
console.usage.missing_link = Wymagany jest link.
console.usage.too_many_arguments = Za dużo argumentów.
console.usage.invalid_characters = Wiersz polecenia zawiera nieprawidłowe znaki.
