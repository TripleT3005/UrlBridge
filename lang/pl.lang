console.no_protocols = brak
console.invalid = Konfiguracja jest nieprawidłowa. Nic nie zostanie uruchomione.
console.test = Protokół:         {name} ({scheme})\nProgram:          {program}\nArgumenty:        {arguments}\nWiersz polecenia: {command_line}
