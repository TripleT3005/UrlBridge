# UrlBridge language file: English (en)
# Category: standard
# Generated by Claude (AI) and reviewed.
# Please report mistakes or better wording as an issue: https://github.com/TripleT3005/UrlBridge/issues
# Reviewed by: @TripleT3005
#
# Format: key = text. Keep the keys and placeholders such as {name} unchanged; \n starts a new line.
# Missing texts are taken from the fallback language, otherwise from English.

language.name = English

confirm.title = Start {name}?
confirm.text = A link wants to start this program. Continue only if you opened the link yourself.
confirm.program = Program:
confirm.arguments = Arguments:
confirm.no_arguments = (none)
confirm.start = Start
confirm.cancel = Cancel

message.close = Close
message.configuration.title = UrlBridge is not set up correctly
message.configuration.text = Nothing was started. Ask your administrator to run "UrlBridge.exe --validate".
message.rejected.title = The link was rejected
message.rejected.text = Nothing was started.
message.launch.title = The program could not be started
message.launch.not_found = {path} was not found or cannot be accessed.
message.launch.windows_error = Windows error {code}.

rejection.too_long = The link is longer than 2048 characters.
rejection.invalid_character = The link contains spaces, control characters or characters outside ASCII.
rejection.missing_scheme = The link has no valid protocol name.
rejection.missing_slashes = The link must have the form protocol://value.
rejection.query = The link contains a query (?).
rejection.fragment = The link contains a fragment (#).
rejection.user_info = The link contains user information (@).
rejection.empty_value = The link contains an empty value.
rejection.invalid_encoding = The link contains invalid percent-encoding.
rejection.unknown_protocol = The protocol "{scheme}" is not configured.
rejection.value_count = The link contains {actual} value(s), but the protocol expects {expected}.
rejection.value.unsafe = The value for "{name}" contains characters that are never allowed.
rejection.value.hostname = The value for "{name}" is not a valid host name.
rejection.value.ipv4 = The value for "{name}" is not a valid IPv4 address.
rejection.value.host = The value for "{name}" is not a valid host name or IPv4 address.
rejection.value.integer = The value for "{name}" is not a number in the allowed range.
rejection.value.token = The value for "{name}" contains characters that are not allowed or is too long.
rejection.value.choice = The value for "{name}" is not one of the allowed values.

console.usage = UrlBridge opens configured programs from custom URL protocols.\n\nUsage:\n  UrlBridge.exe <link>           Check the link, ask for confirmation and start the program\n  UrlBridge.exe --test <link>    Show what would be started without starting it\n  UrlBridge.exe --validate       Check the configuration\n  UrlBridge.exe --version        Show the version\n  UrlBridge.exe --help           Show this help
console.usage.unknown_option = Unknown option: {option}
console.usage.missing_link = A link is required.
console.usage.too_many_arguments = Too many arguments.
console.usage.invalid_characters = The command line contains invalid characters.
console.error = Error: {text}
console.warning = Warning: {text}
console.rejected = Rejected: {text}
console.language = Language: {name} ({code})
console.valid = The configuration is valid. Protocols ({count}): {schemes}
console.no_protocols = none
console.invalid = The configuration is invalid. Nothing will be started.
console.test = Protocol:     {name} ({scheme})\nProgram:      {program}\nArguments:    {arguments}\nCommand line: {command_line}
console.nothing_started = Nothing was started.
console.launch_failed = The program could not be started. {text}
